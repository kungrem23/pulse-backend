APP_ENV=local
HTTP_ADDR=:8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse
DB_PASSWORD=pulse
DB_NAME=pulse
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=pulse
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
SHUTDOWN_TIMEOUT=10s
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=pulse
S3_ACCESS_KEY=pulse
S3_SECRET_KEY=pulse-minio-secret
